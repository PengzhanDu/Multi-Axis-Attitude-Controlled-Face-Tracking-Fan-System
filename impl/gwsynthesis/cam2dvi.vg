module DDR3MI (
  cmd_en,
  wr_data_end,
  clk_d,
  memory_clk,
  rst_n_d,
  DDR_pll_lock,
  wr_data,
  cmd,
  addr,
  cmd_ready,
  wr_data_rdy,
  rd_data_valid,
  dma_clk,
  n7_6,
  DDRPLL_STOP,
  ddr_ck,
  ddr_ck_n,
  ddr_reset_n,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  ddr_cke,
  ddr_odt,
  init_calib_complete,
  ddr_dm,
  ddr_addr,
  ddr_bank,
  rd_data,
  stop_reg,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
)
;
input cmd_en;
input wr_data_end;
input clk_d;
input memory_clk;
input rst_n_d;
input DDR_pll_lock;
input [127:0] wr_data;
input [0:0] cmd;
input [27:3] addr;
output cmd_ready;
output wr_data_rdy;
output rd_data_valid;
output dma_clk;
output n7_6;
output DDRPLL_STOP;
output ddr_ck;
output ddr_ck_n;
output ddr_reset_n;
output ddr_cs;
output ddr_ras;
output ddr_cas;
output ddr_we;
output ddr_cke;
output ddr_odt;
output init_calib_complete;
output [1:0] ddr_dm;
output [14:0] ddr_addr;
output [2:0] ddr_bank;
output [127:0] rd_data;
output [2:2] stop_reg;
inout [1:0] ddr_dqs;
inout [1:0] ddr_dqs_n;
inout [15:0] ddr_dq;
wire VCC;
wire GND;
  \~GW_DDR3_PHY_MC.DDR3MI  gw3_top (
    .cmd_en(cmd_en),
    .wr_data_end(wr_data_end),
    .clk_d(clk_d),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
    .DDR_pll_lock(DDR_pll_lock),
    .wr_data(wr_data[127:0]),
    .cmd(cmd[0]),
    .addr(addr[27:3]),
    .cmd_ready(cmd_ready),
    .wr_data_rdy(wr_data_rdy),
    .rd_data_valid(rd_data_valid),
    .dma_clk(dma_clk),
    .n7_6(n7_6),
    .DDRPLL_STOP(DDRPLL_STOP),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_reset_n(ddr_reset_n),
    .ddr_cs(ddr_cs),
    .ddr_ras(ddr_ras),
    .ddr_cas(ddr_cas),
    .ddr_we(ddr_we),
    .ddr_cke(ddr_cke),
    .ddr_odt(ddr_odt),
    .init_calib_complete(init_calib_complete),
    .ddr_dm(ddr_dm[1:0]),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .rd_data(rd_data[127:0]),
    .stop_reg(stop_reg[2]),
    .ddr_dqs(ddr_dqs[1:0]),
    .ddr_dqs_n(ddr_dqs_n[1:0]),
    .ddr_dq(ddr_dq[15:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DDR3MI */
